# Local development defaults. Do not reuse these settings for Internet-facing production.
APP_ENV=development
APP_PUBLIC_ORIGIN=http://localhost:3000
DATABASE_URL=sqlite:///./outurn.db
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=10485760
DOCUMENT_STORAGE_ROOT=./uploads
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
MAX_PDF_PAGES=50
MAX_PDF_TEXT_CHARS=500000
MAX_IMAGE_PIXELS=40000000
RATE_LIMIT_REQUESTS=180
RATE_LIMIT_WINDOW_SECONDS=60
APP_API_KEY=
WEBHOOK_SECRET_KEY=
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false

# Extraction: auto | local | openai | openrouter | paddle
EXTRACTION_PROVIDER=auto
CRITICAL_CONFIDENCE_THRESHOLD=0.75
MAX_AI_CONCURRENCY=4

# Optional OpenAI extraction. Use a real fine-tuned model id only after the job succeeds.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-08-06
AI_FINETUNED_MODEL_ID=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=45

# Optional OpenRouter grounded extraction. Keep this key server-side only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=45

# Optional local PaddleOCR / PP-StructureV3.
PADDLE_DEVICE=cpu

# End-user triggered geocoding. Keep the base URL configurable and preserve OSM attribution.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=Outurn/0.1 (shipment-assurance-demo)
GEOCODING_TIMEOUT_SECONDS=8

# Frontend BFF (server-side only; never NEXT_PUBLIC)
BACKEND_API_URL=http://localhost:8000
BACKEND_API_KEY=
BACKEND_TIMEOUT_MS=60000
