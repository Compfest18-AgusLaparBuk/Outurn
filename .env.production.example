# Required production values. Generate independent random secrets; never commit this file as `.env`.
APP_ENV=production
APP_PUBLIC_ORIGIN=https://outurn.example.com
CORS_ORIGINS=https://outurn.example.com
APP_API_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHAR_SERVICE_SECRET
WEBHOOK_SECRET_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHAR_WEBHOOK_SECRET_KEY
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://outurn:REPLACE_WITH_STRONG_DATABASE_PASSWORD@postgres:5432/outurn

MAX_UPLOAD_BYTES=10485760
DOCUMENT_STORAGE_ROOT=/data/documents
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
MAX_PDF_PAGES=50
MAX_PDF_TEXT_CHARS=500000
MAX_IMAGE_PIXELS=40000000
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
EXTRACTION_PROVIDER=openrouter
CRITICAL_CONFIDENCE_THRESHOLD=0.75
MAX_AI_CONCURRENCY=4

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-08-06
AI_FINETUNED_MODEL_ID=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=45

# OpenRouter grounded extraction. Keep this key server-side only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=stealth/ox-alpha
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60
PADDLE_DEVICE=cpu
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=Outurn/0.1 (shipment-assurance-demo)
GEOCODING_TIMEOUT_SECONDS=8

BACKEND_API_URL=http://backend:8000
BACKEND_API_KEY=REPLACE_WITH_SAME_VALUE_AS_APP_API_KEY
BACKEND_TIMEOUT_MS=60000
